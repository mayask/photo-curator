# Source: smb (native, read-only) or local (a read-only bind/CIFS mount)
SOURCE_MODE=smb
SMB_HOST=nas.local
SMB_SHARE=photos
SMB_PATH=family
SMB_USER=photo-reader
SMB_PASSWORD=change-me
SMB_PORT=445
SMB_CONNECTION_TIMEOUT=30
# SMB_DOMAIN=

# For SOURCE_MODE=local
PHOTO_ROOT=/photos

# Web/runtime
APP_NAME=Photo Book Curator
APP_PORT=8000
DATA_DIR=/data
DATABASE_URL=sqlite:////data/photo-curator.db
AUTO_START=true
SCAN_INTERVAL_HOURS=24
WORKER_BATCH_SIZE=25
WORKER_POLL_SECONDS=2
# Optional QA/trial cap. 0 scans the complete source; capped scans never deactivate missing files.
SCAN_MAX_FILES=0
MAX_ANALYSIS_ATTEMPTS=3
LOG_LEVEL=INFO

# Analysis tuning
THUMB_SIZE=360
PREVIEW_SIZE=1600
JPEG_QUALITY=84
MAX_FILE_MB=250
MAX_IMAGE_MEGAPIXELS=100
FACE_ANALYSIS=true
FACE_DETECTOR_MODEL=/app/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL=/app/models/face_recognition_sface_2021dec.onnx
HOLIDAY_COUNTRY=
HOLIDAY_SUBDIV=
EVENT_GAP_HOURS=8
BURST_GAP_SECONDS=45
GPS_CLUSTER_KM=25

# Comma-separated names skipped while walking the library
SKIP_DIRECTORIES=@eaDir,#recycle,.snapshot,.thumbnails
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.jpe,.png,.webp,.heic,.heif,.tif,.tiff,.bmp,.gif

# Increment after changing analysis or collection algorithms to force a rebuild
ANALYSIS_VERSION=1
COLLECTION_VERSION=1
